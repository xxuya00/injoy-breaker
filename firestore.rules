// ⚠️ 이 파일은 저장한다고 반영되지 않습니다. Firebase 콘솔의
//    Firestore Database → 규칙(Rules)에 아래 내용을 그대로 붙여넣고 "게시"를 눌러야 적용됩니다.
//    (붙여넣지 않으면 그 컬렉션을 쓰는 코너가 앱에서 "권한이 없습니다"로 조용히 비어 보입니다.)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 플레이어 진행도(조별 실시간 순위판에 쓰임)
    match /players/{playerId} {
      allow read, write: if true;
    }

    // QR 미션 답변
    match /missionAnswers/{playerId} {
      allow read, write: if true;
    }

    // 나만의 잠언(유형 나눔 뒤에 쓰고 서로 읽는 글)
    match /proverbs/{playerId} {
      allow read, write: if true;
    }

    // 자기소개지(DAY 1). 목록 뼈대 · 목록용 작은 그림 · 원본을 따로 둔다.
    // 원본만 1MB에 가깝게 커서, 함께 두면 목록 한 번 여는 데 전부 딸려온다.
    match /introSheets/{playerId} {
      allow read, write: if true;
    }
    match /introSheetThumbs/{playerId} {
      allow read, write: if true;
    }
    // "나만 보기"로 올린 사진은 위 두 곳에 문서를 만들지 않는다. 여기 남아 있어도 참가자 코드를
    // 모르면 목록 어디에도 뜨지 않는다 — 로그인이 없는 앱이라 규칙으로 사람을 가릴 수는 없고,
    // 대신 찾아갈 길을 두지 않는 방식으로 지킨다.
    match /introSheetImages/{playerId} {
      allow read, write: if true;
    }

    // 게임별 개인 기록(gameTimes_crossmath, gameTimes_combo 등 게임마다 컬렉션이 동적으로 생김)
    match /{collection}/{playerId} {
      allow read, write: if collection.matches('^gameTimes_.*$');
    }
  }
}
